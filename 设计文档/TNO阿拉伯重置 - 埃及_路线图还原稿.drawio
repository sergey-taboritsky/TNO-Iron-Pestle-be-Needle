okeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="y14" target="y15a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed208" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="y14" target="y15b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed209" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="y14" target="y15c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oil_hub" value="&lt;b&gt;石油危机（1970）&lt;/b&gt;&lt;br&gt;运河断航 → 输出通道堵塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;strokeWidth=2.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="830" y="1090" width="250" height="85" as="geometry"/></mxCell><mxCell id="ed211" value="苏伊士运河游击战 / 意埃战争" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e13" target="oil_hub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="1115"/></Array></mxGeometry></mxCell><mxCell id="ed212" value="冲击传导" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="oil_hub" target="s_crisis_bar"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="1200"/></Array></mxGeometry></mxCell><mxCell id="ed213" value="冲击传导" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="oil_hub" target="y9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="1000"/></Array></mxGeometry></mxCell><mxCell id="oil_note" value="注：横向虚线表示石油危机的传导，不是「泛阿拉伯激进主义」变量；各国政变/内战/革命是各自国内矛盾的总爆发。" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Microsoft YaHei;textColor=#555555;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="840" y="1180" width="780" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="route-fix" name="辨认待纠正清单"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q_title" value="请在下表直接修改或批注；改完后我以此页为准做设定参考" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#888888;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacingLeft=12;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="q0" value="【已按 2026-11-08 用户纠正修正 ①】法鲁克死前妥协：妥协成功 → 希拉吉丁政府延续；妥协失败 → 莫奈姆亲王摄政。此前两边都标「妥协」，已改。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q1" value="【已修正 ②】1969 华夫脱党两政权不是并列同条件：希拉吉丁妥协成功才出里法特·马赫古卜；妥协失败、以及联合自由党／莫奈姆摄政等线，一律汇入艾哈迈德·阿布·法特。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q2" value="【已修正 ③】1964 年议会选举第三槽位改为「阿里·阿卜杜勒·拉齐克 / 自由市场保守主义 / 联合自由党 - 思想系」。塔哈·侯赛因因失明不任首相，代码里仅为 ULP 党魁兼外交部长（EGY_Taha_Hussein_for）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q3" value="【已修正 ④】叙利亚：1964 总统（达瓦利比／哈法尔）→ 1968 总统选举四种情况 → 石油危机；巴尔马达与库兹巴里均属纳赫拉维军政府的两种后续，二者直连石油危机、不经过 1968 选举；西巴伊线改为「石油危机之后遇刺 → 叙利亚内战」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="295" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q4" value="【已修正 ④-代码印证】IPN_SYR_event.10 拥立纳赫拉维并回土耳其经济圈；event.11.a = 开放选举 + 巴尔马达（真恢复民主），event.11.b = 禁选举 + 联合行政委员会 + 库兹巴里（假恢复民主、纳赫拉维傀儡）；event.9 = 西巴伊、意大利圈、穆兄会。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="425" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q6" value="【待确认 A】1968 年选举的四个候选人，还原稿按「左两席属 1964 达瓦利比当选线、右两席属 1964 哈法尔当选线」分组。这个左右归属对吗？还是应按人民党／民族党分组？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q7" value="【待确认 B】库兹巴里（假恢复民主线）是否也和巴尔马达一样直连石油危机？还原稿暂按两者都直连处理。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q8" value="【待确认 C】西巴伊「遇刺」发生在石油危机之后多久、由谁发动？内战四并列（伊萨姆·阿塔尔／齐亚德·哈里里／里亚德·图尔克／法伊兹·阿塔西）的经济圈归属请核。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q9" value="【待确认 D】图上 1964 年议会选举与代码／新闻的 1963 年（附录 D 已按文本裁决 1963）如何对齐？另叙利亚 1964／1968 两次总统选举与代码 1960.4.8 大选 + 1963 弹劾如何对齐？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q10" value="【待确认 E】叙利亚说明块写「1952 年受埃及未遂政变影响」，口述的埃及未遂政变是 1953 年。年份需统一？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q11" value="【待确认 F】「派来民粹浪潮」箭头小字字面不清，可能是「掀起／换来民粹浪潮」。请正字。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="815" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q12" value="【待确认 G】图中「意大利内战之后埃及随之陷入动乱」——是否应作「意埃战争之后」？动乱五并列里的「安亚尼亚（南苏丹）」如何与苏丹自治领设定衔接？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q13" value="【待确认 H】也门「清除达依拉米系军人，萨拉勒死亡」人名、「希卜利·艾伊萨米 Shibli al-Aysami」拼写请核。也门其余部分用户已确认无误。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="945" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q14" value="【已确认 I】石油危机因果链：华夫脱党自由主义＋民粹主义＋埃及民族主义（合法选举上台）→ 苏伊士游击战 → 意埃战争 → 运河断航／通道堵塞 → 各国各自国内矛盾总爆发 → 石油危机。与泛阿拉伯无关，原版 PanArabRadicalism 死代码不纳入。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1500" height="55" as="geometry"/></mxCell><mxCell id="q15" value="【已确认 J】右下区域（原图 r33）为空白，无节点。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="1075" width="1500" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>