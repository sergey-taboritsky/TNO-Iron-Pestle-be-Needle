<mxfile host="app.diagrams.net" modified="2026-11-08T16:36:00" agent="WorkBuddy" version="24.7.17" type="device"><diagram id="route-main" name="中东政治路线（还原稿）"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="band_egy" value="埃及王国 / 联合自由党 → 华夫脱党 → 苏伊士运河战争" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D79B4A;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacingLeft=12;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="10" y="20" width="820" height="1620" as="geometry"/></mxCell><mxCell id="band_syr" value="叙利亚第三共和国 → 复兴党革命" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FB;strokeColor=#5B8DB8;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacingLeft=12;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="850" y="20" width="820" height="2260" as="geometry"/></mxCell><mxCell id="band_yem" value="也门伊玛目国 / 宪政改革 → 1970 革命" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF8F0;strokeColor=#5AA06B;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacingLeft=12;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="1690" y="20" width="820" height="1420" as="geometry"/></mxCell><mxCell id="egy_note" value="-联合自由党：萨阿德主义制度党和立宪自由党在1948年为了防止第五次纳哈斯内阁而结成联合政府，随后在法鲁克和意大利双方的建议下进行合并，做到对华夫脱党的压制。然而，随着努克拉希、海卡尔在50年代相继去世，党内定于阿卜杜勒·哈迪一尊，导致内部较为年轻和技术官僚的一翼对领导层的不满加剧，党的团结程度不断下滑。&lt;br&gt;萨阿德元老集团：以阿卜杜勒·哈迪为首的前华夫脱党分裂出来的党内元老，掌握大量实权&lt;br&gt;思想系：立宪自由党创建之初传承下来的自由主义学者派系，现在已经事实上成为联合党内立宪自由党的元老俱乐部&lt;br&gt;政务系：亲宫廷的技术官僚集中在该党内形成的新派系&lt;br&gt;-华夫脱党：马卡姆派在纳哈斯于1956年逝世之后回归，相对反宫廷和民族主义的政党，受到打压&lt;br&gt;萨阿德派：扎格鲁勒的直系继承者，如今传递到了希拉吉丁&lt;br&gt;先锋派：以《先锋》杂志为核心的激进自由民族主义者，包括穆罕默德·曼杜尔，艾哈迈德·阿布·法特等&lt;br&gt;新马卡姆派：反对旧有寡头模式的年轻一代自由派技术官僚，如里法特·马赫古卜等，希望进行大规模改革" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="25" y="60" width="300" height="400" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;易卜拉欣·阿卜杜勒·哈迪&lt;/b&gt;&lt;br&gt;无支配体制&lt;br&gt;联合自由党 - 萨阿德元老集团" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="210" height="80" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;君臣冲突导致政府在1962年5月辞职&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="350" y="165" width="210" height="60" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;努雷丁·塔拉夫&lt;/b&gt;&lt;br&gt;自由法团主义&lt;br&gt;联合自由党 - 政务系" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="210" height="80" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;1964年议会选举&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="350" y="355" width="210" height="55" as="geometry"/></mxCell><mxCell id="e5" value="&lt;b&gt;福阿德·希拉吉丁&lt;/b&gt;&lt;br&gt;伊斯兰现代主义&lt;br&gt;华夫脱党 - 萨阿德派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="215" height="85" as="geometry"/></mxCell><mxCell id="e6" value="&lt;b&gt;奥斯曼·艾哈迈德·奥斯曼&lt;/b&gt;&lt;br&gt;自由法团主义&lt;br&gt;联合自由党 - 政务系" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="215" height="85" as="geometry"/></mxCell><mxCell id="e7" value="&lt;b&gt;阿里·阿卜杜勒·拉齐克&lt;/b&gt;&lt;br&gt;自由市场保守主义&lt;br&gt;联合自由党 - 思想系" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="555" y="455" width="215" height="85" as="geometry"/></mxCell><mxCell id="e7_note" value="此槽位原为塔哈·侯赛因；现行代码改为拉齐克。侯赛因因失明不任首相，仅任 ULP 党魁兼外交部长" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Microsoft YaHei;textColor=#555555;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="548" width="430" height="32" as="geometry"/></mxCell><mxCell id="e5a" value="&lt;b&gt;穆罕默德·阿卜杜勒·莫奈姆亲王&lt;/b&gt;&lt;br&gt;临时政府&lt;br&gt;埃及王国摄政委员会" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="190" height="95" as="geometry"/></mxCell><mxCell id="e5b" value="&lt;b&gt;福阿德·希拉吉丁&lt;/b&gt;&lt;br&gt;寡头自由主义&lt;br&gt;华夫脱党 - 核心集团" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="230" y="620" width="190" height="95" as="geometry"/></mxCell><mxCell id="e8" value="&lt;b&gt;奥斯曼·艾哈迈德·奥斯曼&lt;/b&gt;&lt;br&gt;家长制发展主义&lt;br&gt;联合自由党 - 政务系" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="215" height="95" as="geometry"/></mxCell><mxCell id="e9" value="&lt;b&gt;1969年福阿德二世亲政&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="350" y="745" width="210" height="60" as="geometry"/></mxCell><mxCell id="e10" value="&lt;b&gt;民粹运动导致华夫脱党在1969年议会选举大获全胜&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="250" height="80" as="geometry"/></mxCell><mxCell id="e11" value="&lt;b&gt;里法特·马赫古卜&lt;/b&gt;&lt;br&gt;自由技术官僚主义&lt;br&gt;华夫脱党 - 核心集团（新马卡姆派）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="60" y="955" width="230" height="95" as="geometry"/></mxCell><mxCell id="e12" value="&lt;b&gt;艾哈迈德·阿布·法特&lt;/b&gt;&lt;br&gt;社会自由主义&lt;br&gt;华夫脱党 - 先锋派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="450" y="955" width="230" height="95" as="geometry"/></mxCell><mxCell id="e13" value="&lt;b&gt;苏伊士运河游击战&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="355" y="1085" width="210" height="65" as="geometry"/></mxCell><mxCell id="e14" value="&lt;b&gt;意埃战争&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="355" y="1190" width="210" height="60" as="geometry"/></mxCell><mxCell id="e15" value="&lt;b&gt;艾哈迈德·侯赛因&lt;/b&gt;&lt;br&gt;法西斯民粹主义&lt;br&gt;埃及社会党" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="225" height="90" as="geometry"/></mxCell><mxCell id="e16" value="&lt;b&gt;阿卜杜勒·哈基姆·阿密尔&lt;/b&gt;&lt;br&gt;军事独裁&lt;br&gt;埃及王国紧急政府" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="420" y="1290" width="225" height="90" as="geometry"/></mxCell><mxCell id="e17" value="&lt;b&gt;意大利内战之后埃及随之陷入动乱&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="300" y="1410" width="320" height="60" as="geometry"/></mxCell><mxCell id="e18" value="&lt;b&gt;穆斯林兄弟会-社会党联盟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="1510" width="150" height="70" as="geometry"/></mxCell><mxCell id="e19" value="&lt;b&gt;纳赛尔派军官和民族解放工人委员会&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="178" y="1510" width="150" height="70" as="geometry"/></mxCell><mxCell id="e20" value="&lt;b&gt;华夫脱党&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="336" y="1510" width="150" height="70" as="geometry"/></mxCell><mxCell id="e21" value="&lt;b&gt;福阿德二世-埃及军队&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="494" y="1510" width="150" height="70" as="geometry"/></mxCell><mxCell id="e22" value="&lt;b&gt;安亚尼亚（南苏丹）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="652" y="1510" width="150" height="70" as="geometry"/></mxCell><mxCell id="ed30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e3" target="e4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed33" value="失败的联合党内选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e4" target="e6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e4" target="e7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed36" value="法鲁克死前妥协失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e5" target="e5a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed37" value="妥协成功：希拉吉丁政府延续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e5" target="e5b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed38" value="1965法鲁克去世" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;htm