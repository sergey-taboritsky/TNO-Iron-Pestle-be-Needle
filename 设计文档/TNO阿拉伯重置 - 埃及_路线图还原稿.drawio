Cell id="ed44" value="希拉吉丁妥协成功（马赫古卜）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e10" target="e11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed45" value="妥协失败：联合自由党／莫奈姆摄政等线汇入（阿布·法特）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e10" target="e12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed46" value="派来民粹浪潮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e11" target="e13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed47" value="派来民粹浪潮" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e12" target="e13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e13" target="e14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed49" value="战败合作政府" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e14" target="e15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed50" value="亲意军事政变" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e14" target="e16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e15" target="e17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e16" target="e17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e17" target="e18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e17" target="e19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e17" target="e20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e17" target="e21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e17" target="e22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="syr_note" value="-1941年，同盟国进入叙利亚，维希法国驻军投降，库阿特利当选叙利亚总统，对轴心国宣战&lt;br&gt;-战争末期，库阿特利对土投降，在德国允许下土耳其签订叙土防卫条约，实际控制叙利亚，控制其军事训练、货币政策等。&lt;br&gt;-1946年民族党因对土耳其的反对被胡斯尼·扎伊姆政变推翻，持续到1949年&lt;br&gt;-1948年，阿勒颇寡头集团成立了叙利亚人民党&lt;br&gt;-1949年底，扎伊姆被辛纳维推翻，随后在土耳其要求下赛义德·贾扎伊里政府成立&lt;br&gt;-1952年，受埃及未遂政变影响，叙利亚发生希沙克利政变被土耳其军队镇压，希沙克利本人流亡美国，随后人民党上台，采取「旋转门」策略交替执政至今（1960年现任登台）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="55" width="800" height="175" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;鲁什迪·基赫亚&lt;/b&gt;&lt;br&gt;中间派进步主义&lt;br&gt;叙利亚人民党" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="210" height="85" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;1963年德国经济危机导致土耳其经济困难&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1150" y="355" width="230" height="70" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;叙镑贬值危机&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1160" y="445" width="210" height="55" as="geometry"/></mxCell><mxCell id="s_lbl1" value="意大利-土耳其代理人：土耳其支持人民党联合政府，意大利支持民族党激进派" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Microsoft YaHei;textColor=#555555;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="880" y="510" width="760" height="30" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;人民党挺过难关&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="555" width="200" height="60" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;弹劾基赫亚&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1390" y="555" width="200" height="60" as="geometry"/></mxCell><mxCell id="ed65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed67" value="土耳其胜利 / 意大利胜利" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;1964年总统选举（留在土耳其经济圈）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="880" y="650" width="245" height="70" as="geometry"/></mxCell><mxCell id="s6a" value="&lt;b&gt;马鲁夫·达瓦利比&lt;/b&gt;&lt;br&gt;市场自由主义&lt;br&gt;叙利亚人民党" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="860" y="745" width="200" height="90" as="geometry"/></mxCell><mxCell id="s6b" value="&lt;b&gt;卢特菲·哈法尔&lt;/b&gt;&lt;br&gt;自由市场保守主义&lt;br&gt;民族党 - 温和派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1075" y="745" width="200" height="90" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;哈利德·哈兹姆&lt;/b&gt;&lt;br&gt;寡头保守主义&lt;br&gt;民族党 - 地产集团（无经济圈）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1360" y="650" width="230" height="95" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;1965年哈兹姆总统病逝&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1380" y="765" width="200" height="55" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;意大利尝试巩固控制&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1380" y="840" width="200" height="55" as="geometry"/></mxCell><mxCell id="s9a" value="&lt;b&gt;阿卜杜勒·纳赛拉维&lt;/b&gt;&lt;br&gt;军政府&lt;br&gt;叙利亚国防军（回到土耳其经济圈）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1240" y="920" width="215" height="100" as="geometry"/></mxCell><mxCell id="s9b" value="&lt;b&gt;穆斯塔法·西巴伊&lt;/b&gt;&lt;br&gt;伊斯兰民族主义&lt;br&gt;叙利亚穆斯林兄弟会（意大利经济圈）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1465" y="920" width="215" height="100" as="geometry"/></mxCell><mxCell id="s_lbl2" value="民族党彻底失去土耳其信任" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Microsoft YaHei;textColor=#555555;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1360" y="1025" width="320" height="26" as="geometry"/></mxCell><mxCell id="s9c" value="&lt;b&gt;拉沙德·巴尔马达&lt;/b&gt;&lt;br&gt;温和技术官僚主义&lt;br&gt;叙利亚人民党" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;s