7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s18" target="s19b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed158" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s19b" target="s20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed159" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s18" target="s19c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed160" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s19c" target="s20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed161" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s20" target="s21a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed162" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s20" target="s21b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed163" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=10;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s20" target="s21c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="yem_note" value="与otl不同的是，1948年的瓦齐尔政变在瓦齐尔承诺签署更优渥的条约之后得到意大利支持，艾哈迈德最终被意军空袭杀死。随后，瓦齐尔及其兄弟易卜拉欣开展部分现代化改革，包括宪政、议会制以及产业升级。&lt;br&gt;1955年，otl行动的也门自由军官组织并未选择革命，而是暂时配合主权进行改革活动。然而，随着祖拜里总理失势，艾哈迈德·沙米政府日趋保守，与军中改革派渐行渐远。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8A8A8A;strokeWidth=1;dashed=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;spacing=4;" vertex="1" parent="1"><mxGeometry x="1700" y="55" width="800" height="145" as="geometry"/></mxCell><mxCell id="y1" value="&lt;b&gt;艾哈迈德·沙米&lt;/b&gt;&lt;br&gt;二元君主立宪制&lt;br&gt;也门宪政联合会 - 国防保守派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1960" y="225" width="230" height="95" as="geometry"/></mxCell><mxCell id="y2" value="&lt;b&gt;1962年艾哈迈德未遂政变&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1950" y="345" width="250" height="60" as="geometry"/></mxCell><mxCell id="y3" value="&lt;b&gt;清除达依拉米系军人，萨拉勒死亡&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1940" y="430" width="270" height="60" as="geometry"/></mxCell><mxCell id="y4" value="&lt;b&gt;侯赛因·瓦齐尔&lt;/b&gt;&lt;br&gt;二元君主立宪制&lt;br&gt;也门宪政联合会 - 瓦齐尔亲族集团" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1730" y="525" width="225" height="100" as="geometry"/></mxCell><mxCell id="y5" value="&lt;b&gt;穆罕默德·祖拜里&lt;/b&gt;&lt;br&gt;自由法团主义&lt;br&gt;也门宪政联合会 - 宣言派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="2200" y="525" width="225" height="100" as="geometry"/></mxCell><mxCell id="y6" value="&lt;b&gt;阿卜杜勒·瓦齐尔&lt;/b&gt;&lt;br&gt;王室独裁&lt;br&gt;也门人民联盟" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1700" y="665" width="240" height="95" as="geometry"/></mxCell><mxCell id="y7" value="&lt;b&gt;易卜拉欣·瓦齐尔&lt;/b&gt;&lt;br&gt;二元君主立宪制&lt;br&gt;也门宪政联合会 - 元老集团" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1950" y="665" width="240" height="95" as="geometry"/></mxCell><mxCell id="y8" value="&lt;b&gt;穆罕默德·祖拜里&lt;/b&gt;&lt;br&gt;大帐篷&lt;br&gt;也门宪政联合会 - 宣言派" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="2200" y="665" width="240" height="95" as="geometry"/></mxCell><mxCell id="y9" value="&lt;b&gt;石油危机&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;strokeWidth=2.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1970" y="810" width="210" height="65" as="geometry"/></mxCell><mxCell id="y10" value="&lt;b&gt;1970年也门政变：意VS德VS日&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1940" y="910" width="270" height="70" as="geometry"/></mxCell><mxCell id="y11" value="&lt;b&gt;意大利初步胜利：原政府保留&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1700" y="1020" width="230" height="75" as="geometry"/></mxCell><mxCell id="y12" value="&lt;b&gt;日本初步胜利：也门内战&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1950" y="1020" width="230" height="75" as="geometry"/></mxCell><mxCell id="y13" value="&lt;b&gt;德国初步胜利：成功的自由军官革命&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="2200" y="1020" width="250" height="75" as="geometry"/></mxCell><mxCell id="y12a" value="&lt;b&gt;穆罕默德·巴德尔&lt;/b&gt;&lt;br&gt;君主专制&lt;br&gt;正统王国军司令部 / 日本经济圈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F1F1F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;spacing=2;" vertex="1" parent="1"><mxGeometry x="1700" y="1135" width="240" height="100" as="geometry"/></mxCell><mxCell id="y12b" value="&lt;b&gt;侯赛因·瓦齐尔&lt;/b&gt;&lt;br&gt;过渡政府&lt;br&gt;伊玛目国军事委员会 / 意大利经济圈" styl